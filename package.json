{
  "name": "download-accelerator",
  "version": "1.0.0",
  "description": "下载加速器 - undici + stream.pipeline 高速下载",
  "main": "main.js",
  "author": "Win-Box",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "build:dir": "electron-builder --win --x64 --dir"
  },
  "dependencies": {
    "undici": "^7.29.1"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.winbox.download-accelerator",
    "productName": "DownloadAccelerator",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "下载加速器",
      "artifactName": "DownloadAccelerator-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "DownloadAccelerator-Portable-${version}.${ext}"
    }
  }
}
